<Window x:Class="WindDown.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:WindDown.App.Controls" Title="Wind Down">
 <Grid x:Name="Root" RequestedTheme="Default" Background="{ThemeResource WindDownWindowBrush}">
  <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
  <Grid x:Name="TitleBar" Background="Transparent"><StackPanel Orientation="Horizontal" Spacing="9" Margin="18,0,0,0" VerticalAlignment="Center"><FontIcon Glyph="&#xE708;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock Text="Wind Down" FontSize="12"/></StackPanel></Grid>
  <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
   <StackPanel Margin="32,20,32,24" Spacing="20">
    <InfoBar x:Name="Message" IsOpen="False" IsClosable="True" Severity="Error"/>
    <UserControl x:Name="Setup"><UserControl.Transitions><TransitionCollection><EntranceThemeTransition/></TransitionCollection></UserControl.Transitions><StackPanel Spacing="22">
     <StackPanel Spacing="5"><TextBlock x:Name="PageTitle" Text="Power timer" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="A little time. Then, a well-earned rest." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"/></StackPanel>
     <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <ToggleButton x:Name="ShutdownChoice" Style="{StaticResource ActionChoice}" IsChecked="True" HorizontalAlignment="Stretch" Height="58" Click="OnShutdown" AutomationProperties.Name="Shut Down"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE7E8;" FontSize="19"/><TextBlock Text="Shut Down" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></ToggleButton>
      <ToggleButton x:Name="SleepChoice" Style="{StaticResource ActionChoice}" Grid.Column="1" HorizontalAlignment="Stretch" Height="58" Click="OnSleep" AutomationProperties.Name="Sleep"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE708;" FontSize="19"/><TextBlock Text="Sleep" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></ToggleButton>
     </Grid>
     <StackPanel Spacing="14">
      <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="3" CornerRadius="8" ColumnSpacing="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <ToggleButton x:Name="InMode" Style="{StaticResource ActionChoice}" IsChecked="True" Content="In" Height="34" HorizontalAlignment="Stretch" Click="OnIn" AutomationProperties.Name="After a duration"/>
       <ToggleButton x:Name="AtMode" Style="{StaticResource ActionChoice}" Grid.Column="1" Content="At" Height="34" HorizontalAlignment="Stretch" Click="OnAt" AutomationProperties.Name="At a clock time"/>
      </Grid>
      <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <local:TimeDial x:Name="Hours"/>
       <TextBlock Grid.Column="1" Text=":" FontSize="42" FontWeight="Light" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-25,0,0"/>
       <local:TimeDial x:Name="Minutes" Grid.Column="2"/>
       <ComboBox x:Name="Period" Grid.Column="3" Width="72" VerticalAlignment="Center" Margin="0,-24,0,0" Visibility="Collapsed" SelectionChanged="OnPeriodChanged" AutomationProperties.Name="AM or PM"/>
      </Grid>
      <StackPanel x:Name="Presets" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
       <Button Content="30 min" Tag="30" Style="{StaticResource QuietButton}" Click="OnPreset"/><Button Content="1 hr" Tag="60" Style="{StaticResource QuietButton}" Click="OnPreset"/><Button Content="2 hr" Tag="120" Style="{StaticResource QuietButton}" Click="OnPreset"/><Button Content="3 hr" Tag="180" Style="{StaticResource QuietButton}" Click="OnPreset"/>
      </StackPanel>
      <TextBlock x:Name="TargetPreview" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"/>
     </StackPanel>
     <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <FontIcon Glyph="&#xEA8F;" FontSize="16" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <TextBlock Text="Remind me" Grid.Column="1" VerticalAlignment="Center" FontSize="13"/>
      <ComboBox x:Name="Warning" Grid.Column="2" Width="168" SelectionChanged="OnWarningChanged" AutomationProperties.Name="Warning before the action"><ComboBoxItem Content="No warning" Tag="0"/><ComboBoxItem Content="1 minute before" Tag="1"/><ComboBoxItem Content="5 minutes before" Tag="5"/><ComboBoxItem Content="10 minutes before" Tag="10"/></ComboBox>
     </Grid>
     <StackPanel Spacing="10"><Button x:Name="ScheduleButton" Content="Schedule shutdown" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Height="46" Click="OnSchedule"/><Button x:Name="BackButton" Content="Keep current schedule" HorizontalAlignment="Center" Style="{StaticResource QuietButton}" Visibility="Collapsed" Click="OnBack"/></StackPanel>
    </StackPanel>
    </UserControl><StackPanel x:Name="Active" Visibility="Collapsed" Spacing="25" Margin="0,20,0,0"><StackPanel.Transitions><TransitionCollection><EntranceThemeTransition/></TransitionCollection></StackPanel.Transitions>
     <StackPanel Spacing="18" HorizontalAlignment="Center">
      <Border Width="64" Height="64" CornerRadius="32" Background="{ThemeResource AccentFillColorTertiaryBrush}"><FontIcon x:Name="ActiveIcon" Glyph="&#xE7E8;" FontSize="26" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/></Border>
      <TextBlock x:Name="ActiveTitle" Text="Shutdown scheduled" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
     </StackPanel>
     <StackPanel Spacing="5" Margin="0,14,0,0">
      <Viewbox Stretch="Uniform" MaxHeight="76"><TextBlock x:Name="Countdown" Text="02:48:37" FontFamily="Segoe UI Variable Display" FontSize="64" FontWeight="Light" Typography.NumeralAlignment="Tabular"/></Viewbox>
      <TextBlock Text="remaining" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
     </StackPanel>
     <StackPanel Spacing="20"><ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Height="3"/><TextBlock x:Name="ActiveTarget" HorizontalAlignment="Center" FontSize="14"/></StackPanel>
     <TextBlock Text="You can close this window. Windows will take it from here." TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" Margin="25,12"/>
     <StackPanel Spacing="10"><Button x:Name="CancelButton" Content="Cancel shutdown" HorizontalAlignment="Stretch" Height="46" Click="OnCancel"/><Button Content="Change schedule" HorizontalAlignment="Center" Style="{StaticResource QuietButton}" Click="OnEdit"/></StackPanel>
     <TextBlock x:Name="ActiveWarning" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12"/>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
  <Grid Grid.Row="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="22,0,18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE823;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/><TextBlock Grid.Column="1" Text="A quiet finish, on your terms" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Button Grid.Column="2" Style="{StaticResource QuietButton}" AutomationProperties.Name="Settings and about" ToolTipService.ToolTip="Settings and about"><FontIcon Glyph="&#xE713;" FontSize="16"/><Button.Flyout><MenuFlyout><MenuFlyoutSubItem Text="Appearance"><RadioMenuFlyoutItem x:Name="SystemThemeChoice" Text="Use system setting" GroupName="Theme" Tag="Default" IsChecked="True" Click="OnTheme"/><RadioMenuFlyoutItem x:Name="LightThemeChoice" Text="Light" GroupName="Theme" Tag="Light" Click="OnTheme"/><RadioMenuFlyoutItem x:Name="DarkThemeChoice" Text="Dark" GroupName="Theme" Tag="Dark" Click="OnTheme"/></MenuFlyoutSubItem><MenuFlyoutItem Text="How schedules work" Click="OnAbout"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="Exit Wind Down" Click="OnExit"/></MenuFlyout></Button.Flyout></Button></Grid>
 </Grid>
</Window>




