<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>WindDown.App</RootNamespace><AssemblyName>Wind Down</AssemblyName>
    <Product>Wind Down</Product><AssemblyTitle>Wind Down</AssemblyTitle><Description>Schedule this PC to shut down or sleep.</Description>
    <Version>1.0.0</Version><FileVersion>1.0.0.0</FileVersion><AssemblyVersion>1.0.0.0</AssemblyVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms><PlatformTarget>x64</PlatformTarget><RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI><WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained><SelfContained>true</SelfContained>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ApplicationIcon>Assets/WindDown.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <ProjectReference Include="../WindDown.Core/WindDown.Core.csproj" />
    <Content Update="Assets/WindDown.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="PublishXamlResources" AfterTargets="Publish">
    <ItemGroup><NativeResource Include="$(TargetDir)**\*.xbf;$(TargetDir)Wind Down.pri" /></ItemGroup>
    <Copy SourceFiles="@(NativeResource)" DestinationFiles="@(NativeResource->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>


